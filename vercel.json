      "dest": "/collections.html"
    },
    {
      "src": "/sale",
      "dest": "/sale.html"
    },
    {
      "src": "/cart",
      "dest": "/cart.html"
    },
    {
      "src": "/checkout",
      "dest": "/checkout.html"
    },
    {
      "src": "/track-order",
      "dest": "/track-order.html"
